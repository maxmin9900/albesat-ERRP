# Copy to .env for full local Docker stack:
#   copy .env.docker.example .env
#
# Start:
#   docker compose -f docker-compose.yml -f docker-compose.dockerdb.yml run --rm migrate
#   docker compose -f docker-compose.yml -f docker-compose.dockerdb.yml up -d --build

POSTGRES_USER=reza
POSTGRES_PASSWORD=Rz@2026_Postgres!91
POSTGRES_DB=carpet_db

# Used inside Docker network (service names postgres / redis)
DATABASE_URL=postgresql+asyncpg://reza:Rz%402026_Postgres%2191@postgres:5432/carpet_db
REDIS_URL=redis://redis:6379/0

ENVIRONMENT=development
DEBUG=true
API_HOST=0.0.0.0
API_PORT=8000

CORS_ORIGINS=http://localhost:3050,http://127.0.0.1:3050
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_ENABLED=true

JWT_SECRET=change-me-local-docker-dev-only
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_PHONE=5

QR_HMAC_SECRET=local-qr-hmac-secret-change-me

# WhatsApp OTP — three modes:
#   mock     : OTP returned in response as dev_code (local testing, no credentials needed)
#   cloud    : real send via Meta Cloud API — fill ACCESS_TOKEN + PHONE_NUMBER_ID below
#   disabled : WhatsApp off entirely
WHATSAPP_MODE=mock
OTP_SEND_VIA_WHATSAPP=true
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=otp_verification
WHATSAPP_OTP_TEMPLATE_LANGUAGE=fa
# WHATSAPP_OTP_INCLUDE_BUTTON=false

RATE_LIMIT_PER_MINUTE=120
AUDIT_ENABLED=true

NEXT_PUBLIC_API_URL=/api/v1

# Frontend Docker image (bookworm-slim — avoid alpine exec format errors on Windows)
WEB_NODE_IMAGE=node:20-bookworm-slim
