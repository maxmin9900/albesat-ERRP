# Use when Docker Hub (registry-1.docker.io) is blocked or DNS fails.
#   copy .env.docker.mirror.example .env
#   .\scripts\docker-local-up.ps1 -SkipDnsCheck
#
# Also set Docker Desktop -> Docker Engine (see docs/docker-windows-network.md)

POSTGRES_USER=reza
POSTGRES_PASSWORD=Rz@2026_Postgres!91
POSTGRES_DB=carpet_db

# Arvan mirror (try hub.hamdocker.ir/library/... if this fails)
POSTGRES_IMAGE=docker.arvancloud.ir/library/postgres:16-alpine
REDIS_IMAGE=docker.arvancloud.ir/library/redis:7-alpine
PYTHON_IMAGE=docker.arvancloud.ir/library/python:3.11-slim
NODE_IMAGE=docker.arvancloud.ir/library/node:20-bookworm-slim
WEB_NODE_IMAGE=docker.arvancloud.ir/library/node:20-bookworm-slim

DATABASE_URL=postgresql+asyncpg://reza:Rz%402026_Postgres%2191@postgres:5432/carpet_db
REDIS_URL=redis://redis:6379/0

ENVIRONMENT=development
DEBUG=true
CORS_ORIGINS=http://localhost:3050,http://127.0.0.1:3050
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_ENABLED=true

JWT_SECRET=change-me-local-docker-dev-only
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
WHATSAPP_MODE=mock
OTP_SEND_VIA_WHATSAPP=false

QR_HMAC_SECRET=local-qr-hmac-secret-change-me
RATE_LIMIT_PER_MINUTE=120
AUDIT_ENABLED=true

NEXT_PUBLIC_API_URL=/api/v1
