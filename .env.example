# Database (local dev without Docker API)
POSTGRES_USER=reza
POSTGRES_PASSWORD=Rz@2026_Postgres!91
POSTGRES_DB=carpet_db
# DATABASE_URL=postgresql+asyncpg://firoozeh:firoozeh_secret@localhost:5432/firoozeh

# Docker API + DB in containers (docker-compose --profile docker-db up -d):
# DATABASE_URL=postgresql+asyncpg://firoozeh:firoozeh_secret@postgres:5432/firoozeh
# REDIS_URL=redis://redis:6379/0
#
# Server: API in Docker + Postgres/Redis on 127.0.0.1 (docker-compose.hostdb.yml, network_mode: host):
# DATABASE_URL=postgresql+asyncpg://firoozeh:firoozeh_secret@127.0.0.1:5432/firoozeh
# REDIS_URL=redis://127.0.0.1:6379/0
# Password with @ or ! must be URL-encoded (@ → %40, ! → %21)
# Example: Rz@2026_Postgres!91 → Rz%402026_Postgres%2191
DATABASE_URL=postgresql+asyncpg://reza:Rz%402026_Postgres%2191@localhost:5432/carpet_db
# Docker redis (host port 16379 — Windows blocks 6379/6380 on many machines)
REDIS_URL=redis://localhost:16379/0

# API
API_HOST=0.0.0.0
API_PORT=8010
ENVIRONMENT=production
DEBUG=false
CORS_ORIGINS=http://localhost:3050,http://127.0.0.1:3050,https://carpet-pro.ir

# JWT
JWT_SECRET=QoVWPghr3sfqiJjYzdpRCwc07ZyBIES5mKt4x9FlH1UknN2bDOA8TaMvXGL6eu
JWT_ALGORITHM=HS256
JWT_ACCESS_EXPIRE_MINUTES=15
JWT_REFRESH_EXPIRE_DAYS=7

# OTP
OTP_EXPIRE_MINUTES=5
OTP_LENGTH=6
OTP_MAX_ATTEMPTS=5
OTP_RATE_LIMIT_PER_PHONE=5

# QR
QR_HMAC_SECRET=5tfXukIlwAeCGvcoQR2pTMbaLDPhy6S1JN3zsFjVBWqxd0HminE94U7KgYZOr8

# WhatsApp OTP (Meta Cloud API)
WHATSAPP_MODE=cloud
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_OTP_TEMPLATE_NAME=otp_verification
WHATSAPP_OTP_TEMPLATE_LANGUAGE=en
OTP_SEND_VIA_WHATSAPP=true

# Security
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
CSRF_ENABLED=true
RATE_LIMIT_PER_MINUTE=120
AUDIT_ENABLED=true

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8010/api/v1
